/**
 * transcribe-build-info.h — build provenance for libtranscribe / transcribe.dll.
 *
 * Generated at CMake configure time from cmake/transcribe-build-info.h.in.
 * Captures git state + build date + the primary build backend tag so the embedded
 * Windows version resource and the strings-grep-able build-id stay in sync with
 * the library version parsed from include/transcribe/transcribe.h.
 */
#ifndef TRANSCRIBE_BUILD_INFO_H
#define TRANSCRIBE_BUILD_INFO_H

/* "MAJOR.MINOR.PATCH", e.g. "0.2.1" */
#define TRANSCRIBE_BUILD_VERSION "@TRANSCRIBE_VERSION@"
/* Short git sha, e.g. "5dcc27c"; "unknown" for tarballs. */
#define TRANSCRIBE_BUILD_COMMIT  "@TRANSCRIBE_BUILD_COMMIT@"
/* Git branch name, e.g. "main"; "unknown" when git is unavailable. */
#define TRANSCRIBE_BUILD_BRANCH  "@TRANSCRIBE_BUILD_BRANCH@"
/* ISO-8601 UTC build timestamp, e.g. "2026-08-23T01:54:00Z". */
#define TRANSCRIBE_BUILD_DATE    "@TRANSCRIBE_BUILD_DATE@"
/* Primary build-backend tag: "cuda", "rocm", "sycl", "vulkan", "metal", or "cpu". */
#define TRANSCRIBE_BUILD_BACKEND "@TRANSCRIBE_BUILD_BACKEND@"

#endif /* TRANSCRIBE_BUILD_INFO_H */

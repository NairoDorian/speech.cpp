{
  "schema_version": 1,
  "family": "voxtral",
  "display_name": "Mistral Voxtral (2507)",
  "description": "Mistral Voxtral Mini 3B / Small 24B (2507) offline speech recognition and speech translation: a Whisper-large-v3 audio encoder whose frames are grouped 4x and projected into a Llama/Ministral causal LM through audio-token injection, decoded greedily. Loads the transcribe.cpp GGUF layout (general.architecture = voxtral).",
  "category": "asr",
  "status": "supported",
  "tasks": [
    "asr"
  ],
  "modes": [
    "offline"
  ],
  "languages": [
    "en",
    "fr",
    "de",
    "es",
    "it",
    "pt",
    "nl",
    "hi"
  ],
  "capabilities": {
    "asr": [
      "cancellation"
    ]
  },
  "runtime": {
    "tags": [
      "gguf",
      "cpu"
    ]
  },
  "options": {
    "request": [
      {
        "name": "language",
        "type": "string",
        "description": "Spoken-language hint added to the prompt as lang:<code>; empty or auto lets the model detect it.",
        "required": false
      },
      {
        "name": "task",
        "type": "string",
        "description": "transcribe (default) or translate (the instruct template 'Translate this to {Language}.'); the C ABI's task field.",
        "required": false,
        "default": "transcribe"
      },
      {
        "name": "target_language",
        "type": "string",
        "description": "Translation target language code (en, fr, de, es, it, pt, nl, hi); defaults to English.",
        "required": false
      },
      {
        "name": "timestamps",
        "type": "string",
        "description": "Accepted and ignored: none or auto only; the model returns one untimed transcript (the C ABI's timestamps field).",
        "required": false,
        "default": "none"
      }
    ],
    "session": [
      {
        "name": "kv_type",
        "type": "enum",
        "description": "Decoder KV-cache dtype: f16 (default, the transcribe.cpp AUTO policy), f32, or auto (= f16).",
        "values": [
          "f16",
          "f32",
          "auto"
        ],
        "required": false,
        "default": "f16"
      },
      {
        "name": "n_ctx",
        "type": "int",
        "description": "Lower the decoder context ceiling (audio tokens + prompt + generation); 0 uses decoder.max_position_embeddings.",
        "required": false,
        "min": 0,
        "default": 0
      }
    ],
    "load": []
  },

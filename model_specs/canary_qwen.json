        "name": "task",
        "type": "string",
        "description": "transcribe only; translate is rejected (the C ABI's task field).",
        "required": false,
        "default": "transcribe"
      },
      {
        "name": "timestamps",
        "type": "string",
        "description": "Accepted and ignored: the model returns one untimed transcript (the C ABI's timestamps field).",

    "request": [
      {
        "name": "language",
        "type": "string",
        "description": "Spoken language: empty / auto or ru (the model is monolingual); other codes are rejected.",
        "required": false
      },
      {
        "name": "task",
        "type": "string",
        "description": "transcribe only; translate is rejected (no translate head). The C ABI's task field.",
        "required": false,
        "default": "transcribe"
      },
      {
        "name": "timestamps",
        "type": "string",
        "description": "none, auto, segment, word or token (or the C ABI's 0..4). Validated only: every run returns per-token rows timed by their 40 ms encoder frame (the C ABI's TRANSCRIBE_TIMESTAMPS_TOKEN).",
        "required": false,
        "default": "none"
      }
    ],
    "session": [
      {
        "name": "weight_type",
        "type": "enum",
        "description": "Encoder weight storage: native (the GGUF's own types, default), f32 or f16.",
        "values": [
          "native",
          "f32",
          "f16"
        ],
        "required": false,
        "default": "native"
      }
    ],

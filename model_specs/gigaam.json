{
  "schema_version": 1,
  "family": "gigaam",
  "display_name": "GigaAM-v3 ASR",
  "description": "Sber / ai-sage GigaAM-v3 Russian speech recognition: a 16-layer rotary Conformer encoder with an RNN-T or CTC head, in end-to-end (punctuation + casing, SentencePiece) and charwise (lowercase, no punctuation) variants. Loads parent transcribe.cpp's GGUF layout.",
  "category": "asr",
  "status": "supported",
  "tasks": [
    "asr"
  ],
  "modes": [
    "offline"
  ],
  "languages": [
    "ru"
  ],
  "capabilities": {
    "asr": [
      "cancellation"
    ]
  },

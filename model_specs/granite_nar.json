{
  "schema_version": 1,
  "family": "granite_nar",
  "display_name": "IBM Granite Speech NAR",
  "description": "IBM Granite Speech 4.1 2B NAR: a conformer CTC encoder whose BPE-CTC hypothesis is refined in one bidirectional pass by a Granite-4 1B editor fed Q-Former audio tokens (non-autoregressive). Loads the transcribe.cpp GGUF layout (general.architecture = granite_speech_nar).",
  "category": "asr",
  "status": "supported",
  "tasks": [
    "asr"
  ],
  "modes": [
    "offline"
  ],
  "languages": [
    "en",
    "fr",
    "de",
    "es",
    "pt"
  ],
  "capabilities": {
    "asr": [
      "cancellation"
    ]
  },
  "runtime": {
    "tags": [
      "gguf"
    ]
  },
  "options": {
    "request": [
      {
        "name": "language",
        "type": "string",
        "description": "Accepted and ignored: the editor does not condition on a language.",
        "required": false,
        "default": "auto"
      },
      {
        "name": "task",
        "type": "string",
        "description": "transcribe only; translate is rejected (the C ABI's task field).",
        "required": false,
        "default": "transcribe"
      },
      {
        "name": "timestamps",
        "type": "string",
        "description": "Accepted and ignored: the model returns one untimed transcript (the C ABI's timestamps field).",
        "required": false,
        "default": "none"
      }
    ],
    "session": [
      {
        "name": "n_ctx",
        "type": "int",
        "description": "Lower the editor context ceiling (audio tokens + editor text); 0 uses text.max_position_embeddings (4096).",
        "required": false,
        "min": 0,
        "default": 0
      },
      {
        "name": "granite_nar.shaw_bias",
        "type": "enum",
        "description": "Encoder Shaw positional-bias form: skew (default, transcribe.cpp 585b98f7) or direct (the older ctx*ctx lookup; same math, diagnostic).",
        "values": [
          "skew",
          "direct"
        ],
        "required": false,
        "default": "skew"
      }
    ],
    "load": []
  },
  "package_defaults": {
    "download": {
      "kind": "huggingface_snapshot",
      "repo": "handy-computer/granite-speech-4.1-2b-nar-gguf",
      "revision": "main",

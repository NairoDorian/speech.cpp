{
  "schema_version": 1,
  "family": "whisper",
  "display_name": "OpenAI Whisper",
  "description": "OpenAI Whisper robust multilingual speech recognition and translation model family covering 99+ languages, with support for tiny, base, small, medium, large-v3, and large-v3-turbo variants in multilingual and English-only (.en) configurations.",
  "category": "asr",
  "status": "supported",
  "tasks": [
    "asr"
  ],
  "modes": [
    "offline"
  ],
  "languages": [
    "en", "zh", "de", "es", "ru", "ko", "fr", "ja", "pt", "tr",
    "pl", "ca", "nl", "ar", "sv", "it", "id", "hi", "fi", "vi",
    "he", "uk", "el", "ms", "cs", "ro", "da", "hu", "ta", "no",
    "th", "ur", "hr", "bg", "lt", "la", "mi", "ml", "cy", "sk",
    "te", "fa", "lv", "bn", "sr", "az", "sl", "kn", "et", "mk",
    "br", "eu", "is", "hy", "ne", "mn", "bs", "kk", "sq", "sw",
    "gl", "mr", "pa", "si", "km", "sn", "yo", "so", "af", "oc",
    "ka", "be", "tg", "sd", "gu", "am", "yi", "lo", "uz", "fo",
    "ht", "ps", "tk", "nn", "mt", "sa", "lb", "my", "bo", "tl",
    "mg", "as", "tt", "haw", "ln", "ha", "ba", "jw", "su", "yue"
  ],
  "capabilities": {
    "asr": [
      "word_timestamps",
      "vad_chunking",
      "translation",
      "language_detection"
    ]
  },
  "runtime": {
    "tags": [
      "gguf",
      "bin"
    ]
  },
  "options": {
    "request": [
      {
        "name": "language",
        "type": "string",
        "description": "Language code (e.g. 'en', 'zh', 'fr'); default auto-detect.",
        "required": false
      },
      {
        "name": "translate",
        "type": "bool",
        "description": "Translate transcription to English; default false.",
        "required": false,
        "default": false
      },
      {
        "name": "max_tokens",
        "type": "int",
        "description": "Maximum generated transcript tokens; 0 or omitted uses the model limit.",
        "required": false,
        "min": 0,
        "default": 0
      },
      {
        "name": "temperature",
        "type": "float",
        "description": "Sampling temperature; default 0.0 for greedy decode.",
        "required": false,
        "min": 0.0,
        "default": 0.0
      }
    ],
    "session": [
      {
        "name": "weight_type",
        "type": "enum",
        "description": "Shared matmul weight storage type; default native.",
        "preset": "weight_type_full",
        "required": false,
        "default": "native"
      }
    ],
    "load": []
  },
  "package_defaults": {
    "download": {
      "kind": "huggingface_snapshot",
      "repo": "audio-cpp/audio.cpp-gguf",
      "revision": "main",
      "gated": false
    }
  },
  "packages": [
    {
      "id": "whisper_tiny_q8_0",
      "display_name": "Whisper Tiny Q8_0 GGUF",
      "default": true,
      "format": "gguf",
      "precision": "q8_0",
      "target_directory": "Whisper-Tiny-GGUF",
      "files": [
        "Whisper-Tiny-GGUF/whisper-tiny-q8_0.gguf"
      ],
      "strip_prefix": "Whisper-Tiny-GGUF"
    },
    {
      "id": "whisper_tiny_f16",
      "display_name": "Whisper Tiny F16 GGUF",
      "format": "gguf",

// Generated Windows resource script — embeds VS_VERSION_INFO into audiocpp.dll
// so the build version is viewable via file Properties > Details without loading
// the DLL. Generated by CMake from capi/src/audiocpp_version.rc.in.
#include <winver.h>

#define VER_FILEVERSION             @AUDIOCPP_RC_FILEVERSION@
#define VER_FILEVERSION_STR         "@AUDIOCPP_GIT_VERSION@\0"
#define VER_PRODUCTVERSION          @AUDIOCPP_RC_FILEVERSION@
#define VER_PRODUCTVERSION_STR      "@AUDIOCPP_GIT_VERSION@\0"

1 VERSIONINFO
FILEVERSION    VER_FILEVERSION
PRODUCTVERSION VER_PRODUCTVERSION
FILEFLAGSMASK  VS_FFI_FILEFLAGSMASK
FILEFLAGS      0
FILEOS         VOS_NT_WINDOWS32
FILETYPE       VFT_DLL
FILESUBTYPE    VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"  // LangID 0x0409 (en-US), CodePage 0x04B0 (UTF-16LE)
        BEGIN
            VALUE "CompanyName",      "Miaosoft\0"
            VALUE "FileDescription",  "audio.cpp C ABI shared library\0"
            VALUE "FileVersion",      VER_FILEVERSION_STR
            VALUE "InternalName",     "audiocpp\0"
            VALUE "OriginalFilename", "audiocpp.dll\0"
            VALUE "ProductName",      "audio.cpp\0"
            VALUE "ProductVersion",   VER_PRODUCTVERSION_STR
            // Full provenance in Comments so a single field carries everything:
            // version | commit | branch | build date.
            VALUE "Comments",         "audio.cpp-capi | @AUDIOCPP_GIT_VERSION@ | @AUDIOCPP_GIT_COMMIT@ | @AUDIOCPP_GIT_BRANCH@ | @AUDIOCPP_BUILD_DATE@\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 0x04B0
    END
END

# Contents rather than the directory itself, so the negation below can apply --
# git does not descend into an excluded directory, so `/patches/` + `!…/ggml/`
# would not work.
/patches/*
# The ggml patch stack is load-bearing: external/ggml is generated by
# scripts/sync-ggml.sh, and patches/ggml/ is the only thing that survives a
# regeneration. An ignored patch is a delta that silently disappears on the next
# sync -- which is how the two-sided broadcast restore in e11e3c5 went untracked
# (patches 0001-0003 predate this and had to be force-added).
!/patches/ggml/
/target_proj/
/tools_local/
/nocommit/
/perf/
/logs/
/ideas/
/windows_prebuild/
/*.wav
/flutter/
/.cache/

# --- portable bundle: distributed manually, never committed ---
/audiocpp-portable/

# --- Native WebUI build artifacts ---
/webui/native/node_modules/
/webui/native/.svelte-kit/
/webui/native/dist/*
!/webui/native/dist/index.html

# --- release verification scratch (see docs/RELEASING.md) ---
# Upstream audio.cpp c79e588 ignores audio-vtest-*; our release artifacts are
# speech-branded, so ignore both prefixes.
audio-vtest-*
speech-vtest-*

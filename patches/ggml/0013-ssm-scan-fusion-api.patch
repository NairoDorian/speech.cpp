     return result;
 }
 
+void ggml_ssm_scan_set_fusion(
+        struct ggml_tensor        * tensor,
+        enum ggml_ssm_scan_fusion   fusion) {
+    GGML_ASSERT(tensor->op == GGML_OP_SSM_SCAN);
+    // Slot 1, not audio.cpp's slot 0: since ggml 0.24.0 slot 0 holds K (the
+    // number of recurrent states kept, asserted >= 1 by every backend), and
+    // writing the flag there would set K = 0 for FUSION_NONE.
+    ggml_set_op_params_i32(tensor, 1, (int32_t) fusion);
+}

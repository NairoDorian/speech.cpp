+#include "convrot-linear.cuh"
+
+#if defined(GGML_USE_HIP) || defined(GGML_USE_MUSA)
+
+void ggml_cuda_convrot_linear(ggml_backend_cuda_context &, ggml_tensor *) {
+    GGML_ABORT("convrot_linear is only implemented for CUDA");
+}
+

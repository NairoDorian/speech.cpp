{
  "$schema": "https://repomix.com/schemas/latest/schema.json",
  "output": {
    "filePath": "repomix-output.xml",
    "style": "xml",
    "fileSummary": true,
    "directoryStructure": true,
    "files": true,
    "removeComments": false,
    "showLineNumbers": false,
    "copyToClipboard": false,
    "topFilesLength": 20,
    "compress": false,
    "headerText": "speech.cpp — repository pack generated by `bun scripts/arch/repomix.ts`. Do not edit by hand. Read ARCHITECTURE.md first (the generated map), then PLAN.md (North star: end goal + rules R1–R11)."
  },
  "include": [
    "src/**",
    "include/**",
    "app/**",
    "capi/**",
    "scripts/**",
    "tests/**",
    "cmake/**",
    "model_specs/**",
    "tools/**",
    "examples/**",
    "patches/**",
    "bindings/**",
    "webui/**",
    "docs/**",
    "*.md",
    "CMakeLists.txt",
    "CMakePresets.json",
    "Makefile.windows",
    "build_env.bat",
    "repomix.config.json"
  ],
  "ignore": {
    "useGitignore": true,
    "useDefaultPatterns": true,
    "customPatterns": [
      "repomix-output.xml",
      "ARCHITECTURE.md",
      "external/**",
      "build*/**",
      "models/**",
      "docs/archive/**",
      "**/node_modules/**",
      "**/dist/**",
      "**/*.wav",
      "**/*.png",
      "**/*.gguf",
      "**/*.onnx",
      "**/*.bin",
      "**/*.safetensors",
      "tests/golden/**"
    ]
  },
  "security": {
    "enableSecurityCheck": false
  },
  "tokenCount": {
    "encoding": "o200k_base"
  }
}
